    "detail.monitoring.calibrationFailed.previousKept" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calibration failed because no stable face was detected. Your previous calibration was kept."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "校准失败，因为没有检测到稳定的人脸。已保留之前的校准。"
          }
        }
      }
    },
    "detail.monitoring.calibrationFailed.retry" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calibration failed because no stable face was detected. Try again while facing the screen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "校准失败，因为没有检测到稳定的人脸。请正对屏幕后重试。"
          }
        }
      }
    },
    "detail.monitoring.calibrationNeeded" : {
