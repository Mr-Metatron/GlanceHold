    "about.calibrationBody" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calibrate your facing-screen pose before monitoring can use camera signals. Camera access starts only after you choose calibration or monitoring."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先校准正对屏幕的姿态，监控才能使用摄像头信号。只有在你选择校准或开启监控后，摄像头访问才会开始。"
          }
        }
      }
    },
    "about.privacyBody" : {
      "extractionState" : "stale",
