    "action.recalibrate" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Recalibrate Facing Pose" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "重新校准正对姿态" } } } },
