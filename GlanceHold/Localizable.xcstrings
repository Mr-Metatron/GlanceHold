    "action.disableMonitoring" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Disable Monitoring" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭监控" } } } },
    "action.enableMonitoring" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable Monitoring" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开启监控" } } } },
