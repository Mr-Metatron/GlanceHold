    "privacy.note" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Camera stays on this Mac. Frames are not saved or uploaded." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "摄像头画面仅在本机处理，不会保存或上传。" } } } },
    "privacy.permissionExplanation" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "GlanceHold uses the camera only on this Mac to tell whether you are facing the screen. Frames are not saved or uploaded." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "GlanceHold 仅在这台 Mac 上使用摄像头判断你是否正对屏幕。画面不会保存或上传。" } } } },
