    "action.waitingCameraPermission" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Requesting Camera Permission..." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在请求摄像头权限..." } } } },
    "alert.cancel" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Cancel" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "取消" } } } },
    "alert.keepCurrentCalibration" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep Current Calibration" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "保留当前校准" } } } },
    "alert.marginalReplacementPrompt" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The new calibration is usable but less stable than the current one. Keep the current calibration or use the new one?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "新的校准可用，但稳定性不如当前校准。要保留当前校准，还是使用新的校准？" } } } },
    "alert.recalibrationRecommended" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Recalibration recommended" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "建议重新校准" } } } },
    "alert.resetConfirmationMessage" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Reset Calibration: confirm before removing saved calibration; after reset, monitoring returns to Calibration Needed." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "重置校准：移除已保存校准前请确认；重置后监控会回到需要校准状态。" } } } },
    "alert.useNewCalibration" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Use New Calibration" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用新校准" } } } },
    "app.about.window.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "About GlanceHold" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关于 GlanceHold" } } } },
    "app.name" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "GlanceHold" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "GlanceHold" } } } },
    "about.calibrationBody" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Calibrate your facing-screen pose before monitoring can use camera signals. Camera access starts only after you choose calibration or monitoring." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "先校准正对屏幕的姿态，监控才能使用摄像头信号。只有在你选择校准或开启监控后，摄像头访问才会开始。" } } } },
    "about.privacyBody" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Camera stays on this Mac. Frames are not saved or uploaded." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "摄像头画面仅在本机处理，不会保存或上传。" } } } },
    "about.subtitle" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Local camera attention signal" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "本地摄像头注意力信号" } } } },
    "about.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "GlanceHold" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "GlanceHold" } } } },
    "detail.monitoring.calibratingFacingPose" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Face the screen steadily while GlanceHold calibrates your facing pose." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请稳定地正对屏幕，GlanceHold 正在校准你的正对姿态。" } } } },
    "detail.monitoring.calibrationFailed.previousKept" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Calibration failed because no stable face was detected. Your previous calibration was kept." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "校准失败，因为没有检测到稳定的人脸。已保留之前的校准。" } } } },
    "detail.monitoring.calibrationFailed.retry" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Calibration failed because no stable face was detected. Try again while facing the screen." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "校准失败，因为没有检测到稳定的人脸。请正对屏幕后重试。" } } } },
    "detail.monitoring.calibrationNeeded" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Calibrate your facing-screen pose before monitoring can use camera signals. Camera access starts only after you choose calibration or monitoring." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "先校准正对屏幕的姿态，监控才能使用摄像头信号。只有在你选择校准或开启监控后，摄像头访问才会开始。" } } } },
    "detail.monitoring.cameraPermissionDenied" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Camera permission is denied. Allow camera access in System Settings, then enable monitoring again." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "摄像头权限已被拒绝。请在系统设置中允许摄像头访问，然后再次开启监控。" } } } },
    "detail.monitoring.cameraUnavailable" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Camera is unavailable. Check camera access or close other apps using the camera, then try again." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "摄像头不可用。请检查摄像头访问，或关闭正在使用摄像头的其他应用后重试。" } } } },
    "detail.monitoring.iinaUnavailable" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Monitoring cannot start yet because IINA is unavailable." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "IINA 当前不可用，暂时无法开始监控。" } } } },
    "detail.monitoring.readyAfterMarginalCalibration" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Recalibration recommended. Monitoring can continue with the current calibration." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "建议重新校准。仍可使用当前校准继续监控。" } } } },
    "detail.player.idle" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "IINA is open without active playback. No playback command will be sent." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "IINA 已打开但没有正在播放的内容。不会发送播放命令。" } } } },
    "detail.player.notControllable" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "IINA playback state is readable but not safe to control. No playback command will be sent." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "可以读取 IINA 播放状态，但当前不适合控制。不会发送播放命令。" } } } },
    "detail.player.setupNeeded" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Install or enable the GlanceHold IINA plugin. Start IINA or load a video before playback control can connect." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请安装或启用 GlanceHold IINA 插件。启动 IINA 或载入视频后，播放控制才能连接。" } } } },
    "detail.player.unavailable" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Attention monitoring can continue while playback control waits for controllable IINA state." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "注意力监控可以继续；播放控制会等待 IINA 进入可控制状态。" } } } },
    "format.delay.seconds" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%.1fs" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%.1f秒" } } } },
