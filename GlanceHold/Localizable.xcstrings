        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "摄像头权限已被拒绝。请在系统设置中允许摄像头访问，然后再次开启监控。"
          }
        }
      }
    },
    "detail.monitoring.cameraUnavailable" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera is unavailable. Check camera access or close other apps using the camera, then try again."
